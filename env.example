ORACLE_WALLET_DIR=/ruta/privada/wallet
ORACLE_TNS_ALIAS=biblioteca_low
LOCAL_HTTP_PORT=8090
PUBLIC_HOST=foro.ejemplo.cl
IMAGE_PREFIX=foro-nexo
IMAGE_TAG=s5
